# ==============================================================================
# Application Configuration
# ==============================================================================
PROJECT_NAME="ExpenseFlow Pro"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# ==============================================================================
# Database Configuration (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
# ==============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expenseflow_db"

# ==============================================================================
# Security & Authentication (JWT)
# ==============================================================================
# Generate a secure key in production with: openssl rand -hex 32
JWT_SECRET_KEY="dev-secret-key-change-this-in-production-expenseflow-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 Hours

# ==============================================================================
# CORS Configuration (Allowed Frontend Origins)
# ==============================================================================
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","http://127.0.0.1:5500","http://127.0.0.1:8081"]

# ==============================================================================
# In-app Android updates (bump version_code when you upload a new APK)
# ==============================================================================
APP_LATEST_VERSION="1.0.0"
APP_LATEST_VERSION_CODE=1
APP_RELEASE_NAME="ExpenseFlow Pro"
APP_RELEASE_NOTES=["Bug fixes and performance improvements"]
APP_APK_URL="https://github.com/yashdesai19/ExpenseFlow/raw/yash/android/app/release/app-release.apk"
APP_WEB_URL="https://expenseflow-1add.onrender.com/ui/"
APP_FORCE_UPDATE=False
